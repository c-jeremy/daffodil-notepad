<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Daffodil" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/daffodil_dark</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFFBEAB8</item>
        <item name="colorOnPrimaryContainer">#FF3A2C00</item>
        <item name="colorSecondary">@color/daffodil_dark</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="android:colorBackground">@color/home_bg</item>
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:statusBarColor">@color/home_bg</item>
        <item name="android:navigationBarColor">@color/home_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Daffodil.Editor">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="ToolButton">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:padding">5.5dp</item>
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="ToolDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/divider_v</item>
    </style>
</resources>
